<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
<fullName>OPP_Discount_Approved</fullName>
<active>true</active>
<errorConditionFormula>Discount_Pct__c &gt; $CustomMetadata.Zco_Commercial_Setting__mdt.Default.Max_Discount_Without_Approval__c &amp;&amp; ISPICKVAL(StageName,'Payment Link Sent') &amp;&amp; NOT(ISPICKVAL(Discount_Approval__c,'Approved'))</errorConditionFormula>
<errorMessage>Discount above the limit needs approval.</errorMessage>
</ValidationRule>