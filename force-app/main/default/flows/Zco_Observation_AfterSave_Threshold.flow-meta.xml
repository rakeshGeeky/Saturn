<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Evaluate_Threshold</name>
        <label>Evaluate observation threshold</label>
        <locationX>50</locationX>
        <locationY>240</locationY>
        <actionName>ZcoEvaluateObservationThresholdAction</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>observationId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>ZcoEvaluateObservationThresholdAction</nameSegment>
        <versionSegment>1</versionSegment>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Needs_Escalation</name>
        <label>Needs escalation?</label>
        <locationX>50</locationX>
        <locationY>480</locationY>
        <defaultConnectorLabel>No action needed</defaultConnectorLabel>
        <rules>
            <name>Escalate_Required</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Evaluate_Threshold.outsideThreshold</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Evaluate_Threshold.actionRequired</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Escalate</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Escalate_Safety</targetReference>
            </connector>
            <label>Escalate required</label>
        </rules>
        <rules>
            <name>Monitor_Required</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Evaluate_Threshold.outsideThreshold</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Evaluate_Threshold.actionRequired</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Monitor</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Monitoring_Task</targetReference>
            </connector>
            <label>Monitor required</label>
        </rules>
    </decisions>
    <description>Evaluate a clinical observation against safety thresholds and escalate or create a monitoring task.</description>
