        <locationY>0</locationY>
        <connector>
            <targetReference>Evaluate_Threshold</targetReference>
        </connector>
        <filterFormula>OR(ISNEW(), ISCHANGED({!$Record.Value__c}))</filterFormula>
        <object>Clinical_Observation__c</object>
