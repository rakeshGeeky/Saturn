    <decisions>
        <name>State_Router</name>
        <label>Care journey state?</label>
        <locationX>50</locationX>
        <locationY>120</locationY>
        <defaultConnectorLabel>No action</defaultConnectorLabel>
        <rules>
            <name>Due</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.State__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Due</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Checkin_Template</targetReference>
            </connector>
            <label>Due</label>
        </rules>
        <rules>
            <name>Lost_To_FollowUp</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.State__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lost to follow-up</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_LTFU_Task</targetReference>
            </connector>
            <label>Lost to follow-up</label>
        </rules>
        <rules>
            <name>Pre_Consult_Ready</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.State__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
