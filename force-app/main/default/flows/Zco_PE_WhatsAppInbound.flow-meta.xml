    <decisions>
        <name>Message_Already_Logged</name>
        <label>Message already logged?</label>
        <locationX>176</locationX>
        <locationY>480</locationY>
        <defaultConnector>
            <targetReference>Create_WhatsApp_Message</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not logged yet</defaultConnectorLabel>
        <rules>
            <name>Already_Logged</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Find_Existing_Message.Id</leftValueReference>
